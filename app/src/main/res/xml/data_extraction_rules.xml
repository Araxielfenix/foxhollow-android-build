<?xml version="1.0" encoding="utf-8"?>
<!-- data_extraction_rules.xml - Reglas de copia de seguridad (Android 12+) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
