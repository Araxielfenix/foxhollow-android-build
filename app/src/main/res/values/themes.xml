<?xml version="1.0" encoding="utf-8"?>
<!-- themes.xml - Foxhollow themes -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Foxhollow" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/theme_primary</item>
        <item name="colorPrimaryVariant">@color/theme_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/theme_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/theme_background</item>
        <item name="colorSurface">@color/theme_background</item>
        <item name="colorOnSurface">@color/white</item>
        <!-- Transparent bars so the game is not pushed down by a purple stripe -->
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Fullscreen theme for gameplay -->
    <style name="Theme.Foxhollow.Fullscreen" parent="Theme.Foxhollow">
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Edge-to-edge: allow content to draw behind system bars -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>
