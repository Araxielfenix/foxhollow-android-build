<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml - Foxhollow Android Manifest -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="dev.encounter.foxhollow">

    <!-- Permissions for file access and storage -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    
    <!-- Network access for potential updates/mods -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Wake lock to prevent sleep during gameplay -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Vibration support -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Foreground service for background downloads (mods, updates) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Hardware features (optional but recommended) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />  // OpenGL ES 3.0

    <application
        android:name=".FoxhollowApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Foxhollow"
        android:usesCleartextTraffic="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        tools:targetApi="31">

        <!-- Main Activity - Uses BorealisActivity which extends SDLActivity -->
        <activity
            android:name=".FoxhollowActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Foxhollow.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden|density|fontScale|uiMode"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:resizeableActivity="false">
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- Handle file opening (ISO files) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-iso9660-image" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\.iso" />
                <data android:pathPattern=".*\.ISO" />
                <data android:pathPattern=".*\.gcm" />
                <data android:pathPattern=".*\.GCM" />
                <data android:pathPattern=".*\.rvz" />
                <data android:pathPattern=".*\.RVZ" />
            </intent-filter>
            
            <!-- Handle game folder selection -->
            <intent-filter>
                <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Documents Provider for SAF (Storage Access Framework) -->
        <provider
            android:name="dev.encounter.borealis.BorealisDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Native library loading -->
        <meta-data
            android:name="android.app.lib_name"
            android:value="foxhollow" />

        <!-- Required for SDL3 -->
        <meta-data
            android:name="org.libsdl.app.SDLActivity"
            android:value="dev.encounter.foxhollow.FoxhollowActivity" />

    </application>

    <!-- Queries for package visibility (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
        </intent>
    </queries>

</manifest>
