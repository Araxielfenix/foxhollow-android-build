# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root on purpose. The unanchored form excluded every
# nested directory named 'lib', which silently dropped all of aurora's
# implementation (extern/aurora/lib) from the repository.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Gradle
.gradle/
build/
app/build/
!app/build/.gitkeep

# Android Studio
.idea/
*.iml
local.properties
*.keystore

# NDK
build-android-*/
*.o
*.a
*.so

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
*.swp
*.swo

# Logs
*.log

# Environment
.env

# CMake / NDK generated inside the Gradle module
app/.cxx/

# Backup copies made while integrating the upstream dependencies
*.bak/

# Prebuilt arm64 third-party dependency required to build.
# Overrides the generic 'lib/' and '*.a' rules above.
!third_party/jpeg-turbo-arm64/lib/
!third_party/jpeg-turbo-arm64/lib/**
